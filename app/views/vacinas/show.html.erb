<% content_for :title, @vacina.nome %>
<div class="bg-white rounded-xl shadow p-6 max-w-lg space-y-3">
    <h2 class="text-xl font-semibold text-gray-800"><%= @vacina.nome %> — <%= @vacina.pet.nome %></h2>
    <p class="text-gray-600"><span class="font-medium">Aplicação:</span> <%= @vacina.data_aplicacao.strftime("%d/%m/%Y") %></p>
    <p class="text-gray-600"><span class="font-medium">Próxima dose:</span> <%= @vacina.proxima_dose&.strftime("%d/%m/%Y") || "-" %></p>
    <p class="text-gray-600"><span class="font-medium">Lote:</span> <%= @vacina.lote %></p>
    <p class="text-gray-600"><span class="font-medium">Fabricante:</span> <%= @vacina.fabricante %></p>
    <div class="flex gap-3 pt-4">
        <%= link_to "Editar", edit_vacina_path(@vacina), class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition" %>
        <%= link_to "Voltar", vacinas_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
    </div>
</div>

