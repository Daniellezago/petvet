<%= form_with model: vacina, local: true, class: "space-y-4 bg-white rounded-xl shadow p-6 max-w-lg" do |f| %>
    <% if vacina.errors.any? %>
    <div class="bg-red-50 text-red-700 text-sm rounded p-3">
        <ul class="list-disc list-inside"><% vacina.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
    <% end %>
    <div>
    <%= f.label :pet_id, "Pet", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :pet_id, Pet.all, :id, :nome, {}, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :nome, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :nome, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
    </div>
    <div>
    <%= f.label :categoria, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :categoria, [ [ "Vacina", "vacina" ], [ "Antiparasitário", "antiparasitario" ] ], {}, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :data_aplicacao, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :data_aplicacao, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :proxima_dose, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :proxima_dose, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :lote, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :lote, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :fabricante, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :fabricante, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :observacoes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :observacoes, rows: 2, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div class="flex gap-3">
    <%= f.submit class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold transition cursor-pointer" %>
    <%= link_to "Cancelar", vacinas_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
    </div>
<% end %>

