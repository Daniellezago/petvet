<% content_for :title, "Vacinas" %>
<div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-800">Vacinas</h2>
    <%= link_to "Nova vacina", new_vacina_path, class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold transition" %>
</div>
<div class="bg-white rounded-xl shadow overflow-hidden">
    <table class="w-full text-sm text-left">
    <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
        <tr><th class="px-6 py-3">Nome</th><th class="px-6 py-3">Pet</th><th class="px-6 py-3">Aplicação</th><th class="px-6 py-3">Próxima dose</th><th class="px-6 py-3">Ações</th></tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
        <% @vacinas.each do |vacina| %>
        <tr class="hover:bg-gray-50">
            <td class="px-6 py-3 font-medium text-gray-800"><%= vacina.nome %></td>
            <td class="px-6 py-3 text-gray-600"><%= vacina.pet.nome %></td>
            <td class="px-6 py-3 text-gray-600"><%= vacina.data_aplicacao.strftime("%d/%m/%Y") %></td>
            <td class="px-6 py-3 text-gray-600"><%= vacina.proxima_dose&.strftime("%d/%m/%Y") || "-" %></td>
            <td class="px-6 py-3 space-x-2">
            <%= link_to "Ver", vacina_path(vacina), class: "text-emerald-700 hover:underline" %>
            <%= link_to "Editar", edit_vacina_path(vacina), class: "text-blue-600 hover:underline" %>
        </td>
        </tr>
        <% end %>
    </tbody>
    </table>
</div>
