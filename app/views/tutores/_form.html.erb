<%= form_with model: tutor, local: true, class: "bg-white rounded-xl shadow max-w-2xl" do |f| %>
  <div class="px-6 py-5 border-b border-gray-100 flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
      <i data-lucide="user" class="w-5 h-5 text-emerald-600"></i>
    </div>
    <div>
      <h3 class="text-base font-semibold text-gray-800">
        <%= tutor.persisted? ? "Dados do Tutor" : "Cadastrar Novo Tutor" %>
      </h3>
      <p class="text-xs text-gray-400">
        <%= tutor.persisted? ? "Atualize as informações abaixo" : "Preencha as informações para o cadastro" %>
      </p>
    </div>
  </div>

  <div class="px-6 py-6 space-y-5">
    <% if tutor.errors.any? %>
      <div class="bg-red-50 border border-red-100 text-red-700 text-sm rounded-lg p-4 flex gap-3">
        <i data-lucide="alert-circle" class="w-4 h-4 shrink-0 mt-0.5"></i>
        <div>
          <p class="font-semibold mb-1">
            <%= pluralize(tutor.errors.count, "erro encontrado", "erros encontrados") %>
          </p>
          <ul class="list-disc list-inside space-y-0.5">
            <% tutor.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div>
      <%= f.label :nome, "Nome", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="relative">
        <i data-lucide="user" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        <%= f.text_field :nome, placeholder: "Nome Completo",
            class: "w-full pl-9 rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div class="relative">
          <i data-lucide="mail" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <%= f.email_field :email, placeholder: "email@exemplo.com",
              class: "w-full pl-9 rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
        </div>
      </div>

      <div>
        <%= f.label :telefone, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div class="relative">
          <i data-lucide="phone" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <%= f.text_field :telefone, placeholder: "(00) 00000-0000",
              class: "w-full pl-9 rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :cpf, "CPF", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div class="relative">
          <i data-lucide="id-card" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <%= f.text_field :cpf, placeholder: "000.000.000-00",
              class: "w-full pl-9 rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
        </div>
      </div>

      <div>
        <%= f.label :endereco, "Endereço", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div class="relative">
          <i data-lucide="map-pin" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <%= f.text_field :endereco, placeholder: "Rua, número, bairro, cidade",
              class: "w-full pl-9 rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
        </div>
      </div>
    </div>
  </div>

  <div class="px-6 py-4 border-t border-gray-100 flex items-center gap-3">
    <%= f.submit (tutor.persisted? ? "Salvar alterações" : "Cadastrar tutor"),
        class: "bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition cursor-pointer" %>
    <%= link_to "Cancelar", tutores_path,
        class: "px-5 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition" %>
  </div>
<% end %>
