<%= form_with model: tutor, local: true, class: "space-y-4 bg-white rounded-xl shadow p-6 max-w-lg" do |f| %>
  <% if tutor.errors.any? %>
    <div class="bg-red-50 text-red-700 text-sm rounded p-3">
      <ul class="list-disc list-inside">
        <% tutor.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :nome, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :nome, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :telefone, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :telefone, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :cpf, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :cpf, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :endereco, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :endereco, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold transition cursor-pointer" %>
    <%= link_to "Cancelar", tutores_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>