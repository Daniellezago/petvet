<%= form_with model: exame, local: true, multipart: true, class: "space-y-4 bg-white rounded-xl shadow p-6 max-w-lg" do |f| %>
    <% if exame.errors.any? %>
    <div class="bg-red-50 text-red-700 text-sm rounded p-3">
        <ul class="list-disc list-inside"><% exame.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
    <% end %>
    <div>
    <%= f.label :pet_id, "Pet", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :pet_id, Pet.all, :id, :nome, {}, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :tipo_exame, "Tipo de exame", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :tipo_exame, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
    </div>
    <div>
    <%= f.label :data, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :data, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :resultado, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :resultado, rows: 3, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :observacoes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :observacoes, rows: 2, class: "w-full rounded border border-gray-300 p-2" %>
    </div>
    <div>
    <%= f.label :arquivo, "Laudo (PDF, JPEG ou PNG)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.file_field :arquivo, class: "w-full text-sm text-gray-600" %>
    </div>
    <div class="flex gap-3">
    <%= f.submit class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold transition cursor-pointer" %>
    <%= link_to "Cancelar", exames_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
    </div>
<% end %>

