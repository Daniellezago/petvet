<% content_for :title, @exame.tipo_exame %>
<div class="bg-white rounded-xl shadow p-6 max-w-lg space-y-3">
    <h2 class="text-xl font-semibold text-gray-800"><%= @exame.tipo_exame %> — <%= @exame.pet.nome %></h2>
    <p class="text-gray-600"><span class="font-medium">Data:</span> <%= @exame.data.strftime("%d/%m/%Y") %></p>
    <p class="text-gray-600"><span class="font-medium">Resultado:</span> <%= @exame.resultado %></p>
    <% if @exame.arquivo.attached? %>
    <p><%= link_to "Baixar laudo", url_for(@exame.arquivo), class: "text-emerald-700 hover:underline", target: "_blank" %></p>
    <% end %>
    <div class="flex gap-3 pt-4">
    <%= link_to "Editar", edit_exame_path(@exame), class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition" %>
    <%= link_to "Voltar", exames_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
</div>
</div>
