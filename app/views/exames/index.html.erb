<% content_for :title, "Exames" %>
<div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-800">Exames</h2>
    <%= link_to "Novo exame", new_exame_path, class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold transition" %>
</div>
<div class="bg-white rounded-xl shadow overflow-hidden">
    <table class="w-full text-sm text-left">
    <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
        <tr><th class="px-6 py-3">Tipo</th><th class="px-6 py-3">Pet</th><th class="px-6 py-3">Data</th><th class="px-6 py-3">Arquivo</th><th class="px-6 py-3">Ações</th></tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
        <% @exames.each do |exame| %>
        <tr class="hover:bg-gray-50">
            <td class="px-6 py-3 font-medium text-gray-800"><%= exame.tipo_exame %></td>
            <td class="px-6 py-3 text-gray-600"><%= exame.pet.nome %></td>
            <td class="px-6 py-3 text-gray-600"><%= exame.data.strftime("%d/%m/%Y") %></td>
            <td class="px-6 py-3 text-gray-600">
            <% if exame.arquivo.attached? %>
                <span class="text-emerald-700">📎 anexado</span>
            <% else %>
                <span class="text-gray-400">-</span>
            <% end %>
            </td>
        <td class="px-6 py-3 space-x-2">
            <%= link_to "Ver", exame_path(exame), class: "text-emerald-700 hover:underline" %>
            <%= link_to "Editar", edit_exame_path(exame), class: "text-blue-600 hover:underline" %>
        </td>
        </tr>
        <% end %>
    </tbody>
    </table>
</div>
