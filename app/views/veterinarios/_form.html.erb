<%= form_with model: veterinario, local: true, class: "bg-white rounded-xl shadow max-w-2xl" do |f| %>
    <div class="px-6 py-5 border-b border-gray-100 flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
            <i data-lucide="stethoscope" class="w-5 h-5 text-emerald-600"></i>
    </div>
        <div>
        <h3 class="text-base font-semibold text-gray-800">
            <%= veterinario.persisted? ? "Dados do Veterinário" : "Cadastrar Novo Veterinário" %>
        </h3>
        <p class="text-xs text-gray-400">
            <%= veterinario.persisted? ? "Atualize as informações abaixo" : "Preencha as informações para o cadastro" %>
        </p>
    </div>
        </div>

    <div class="px-6 py-6 space-y-5">
            <% if veterinario.errors.any? %>
    <div class="bg-red-50 border border-red-100 text-red-700 text-sm rounded-lg p-4 flex gap-3">
        <i data-lucide="alert-circle" class="w-4 h-4 shrink-0 mt-0.5"></i>
        <div>
            <p class="font-semibold mb-1">
                <%= pluralize(veterinario.errors.count, "erro encontrado", "erros encontrados") %>
            </p>
            <ul class="list-disc list-inside space-y-0.5">
                <% veterinario.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
            <% end %>
            </ul>
        </div>
    </div>
<% end %>

    <div>
        <%= f.label :user_id, "Usuário vinculado (login)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :user_id, usuarios_disponiveis, :id, :email, { prompt: "Selecione o usuário" },
            class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
        <p class="text-xs text-gray-400 mt-1">
        Só aparecem usuários com papel "Veterinário" que ainda não têm um perfil profissional cadastrado.
        </p>
    </div>

    <div>
        <%= f.label :nome, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div class="relative">
            <i data-lucide="user" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <%= f.text_field :nome, placeholder: "Nome completo",
                class: "w-full pl-9 rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
            <%= f.label :crmv, "CRMV", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div class="relative">
            <i data-lucide="badge-check" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <%= f.text_field :crmv, placeholder: "Ex: CRMV-SP 12345",
                class: "w-full pl-9 rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
        </div>
    </div>
        <div>
            <%= f.label :especialidade, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :especialidade, placeholder: "Ex: Dermatologia (opcional)",
                class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
        </div>
    </div>

    <div>
        <%= f.label :cor_agenda, "Cor de identificação na agenda", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div class="flex items-center gap-3">
            <%= f.color_field :cor_agenda, class: "w-12 h-10 rounded border border-gray-300 cursor-pointer" %>
            <span class="text-xs text-gray-400">Usada para diferenciar a agenda deste veterinário visualmente.</span>
        </div>
    </div>
</div>

    <div class="px-6 py-4 border-t border-gray-100 flex items-center gap-3">
        <%= f.submit (veterinario.persisted? ? "Salvar alterações" : "Cadastrar veterinário"),
            class: "bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition cursor-pointer" %>
        <%= link_to "Cancelar", veterinarios_path,
            class: "px-5 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition" %>
    </div>
<% end %>
