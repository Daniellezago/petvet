<% content_for :title, "Veterinários" %>

<div class="bg-white rounded-xl shadow overflow-hidden">
    <div class="flex justify-between items-center px-6 pt-5 pb-4 border-b border-gray-100">
        <div class="flex items-center gap-2">
            <i data-lucide="stethoscope" class="w-5 h-5 text-emerald-600"></i>
    <div>
        <h3 class="text-base font-semibold text-gray-800">Lista de Veterinários</h3>
        <p class="text-xs text-gray-400 mt-0.5">
            <%= pluralize(@veterinarios.total_count, "veterinário cadastrado", "veterinários cadastrados") %>
        </p>
    </div>
</div>
    <%= link_to new_veterinario_path, class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold transition flex items-center gap-2" do %>
        <i data-lucide="plus" class="w-4 h-4"></i> Novo Veterinário
    <% end %>
</div>

<%= form_with url: veterinarios_path, method: :get, local: true, class: "flex items-center justify-between gap-4 px-6 py-4 border-b border-gray-100" do |f| %>
    <div class="relative flex-1 max-w-md">
        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        <%= f.text_field :busca, value: params[:busca], placeholder: "Buscar por nome, CRMV ou especialidade...",
            class: "w-full pl-9 rounded border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
    </div>

    <label class="flex items-center gap-2 text-sm cursor-pointer select-none">
        <span class="<%= params[:mostrar_inativos] == "1" ? "text-gray-400" : "text-emerald-700 font-semibold" %>">Ativos</span>
        <span class="relative inline-block w-10 h-5">
            <%= f.check_box :mostrar_inativos,
                { checked: params[:mostrar_inativos] == "1", class: "sr-only peer", onchange: "this.form.requestSubmit()" },
                "1", "0" %>
        <span class="absolute inset-0 rounded-full bg-gray-300 peer-checked:bg-gray-600 transition-colors pointer-events-none"></span>
        <span class="absolute left-0.5 top-0.5 w-4 h-4 bg-white rounded-full shadow transition-transform peer-checked:translate-x-5 pointer-events-none"></span>
        </span>
        <span class="<%= params[:mostrar_inativos] == "1" ? "text-gray-700 font-semibold" : "text-gray-400" %>">Inativos</span>
    </label>
<% end %>

<table class="w-full text-sm text-left">
    <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
        <tr>
            <th class="px-6 py-3"><%= veterinario_sortable_column_link("Nome", "nome") %></th>
            <th class="px-6 py-3"><%= veterinario_sortable_column_link("CRMV", "crmv") %></th>
            <th class="px-6 py-3">Especialidade</th>
            <th class="px-6 py-3">Usuário</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3">Ações</th>
        </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
        <% @veterinarios.each do |veterinario| %>
            <tr class="hover:bg-gray-50">
                <td class="px-6 py-3">
                    <div class="flex items-center gap-3">
                <span class="w-3 h-3 rounded-full shrink-0" style="background-color: <%= veterinario.cor_agenda %>"></span>
                <span class="font-medium text-gray-800"><%= veterinario.nome %></span>
                    </div>
                </td>
                    <td class="px-6 py-3 text-gray-600 font-mono text-xs"><%= veterinario.crmv %></td>
                    <td class="px-6 py-3 text-gray-600"><%= veterinario.especialidade.presence || "-" %></td>
                    <td class="px-6 py-3 text-gray-600"><%= veterinario.user.email %></td>
                    <td class="px-6 py-3">
            <% if veterinario.ativo? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-emerald-100 text-emerald-700">Ativo</span>
            <% else %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-gray-100 text-gray-500">Inativo</span>
        <% end %>
                    </td>
                    <td class="px-6 py-3 space-x-2 whitespace-nowrap">
            <%= link_to "Ver", veterinario_path(veterinario), class: "text-emerald-700 hover:underline" %>
            <%= link_to "Editar", edit_veterinario_path(veterinario), class: "text-blue-600 hover:underline" %>
            <% if veterinario.ativo? %>
            <%= link_to "Desativar", veterinario_path(veterinario),
                data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja desativar #{veterinario.nome}?" },
                class: "text-red-600 hover:underline" %>
            <% else %>
            <%= link_to "Reativar", reativar_veterinario_path(veterinario),
                data: { turbo_method: :patch, turbo_confirm: "Reativar #{veterinario.nome}?" },
                class: "text-emerald-600 hover:underline" %>
            <% end %>
                    </td>
        </tr>
    <% end %>
    </tbody>
</table>

<% if @veterinarios.empty? %>
    <p class="text-center text-gray-400 py-8 text-sm">Nenhum veterinário encontrado.</p>
<% end %>
</div>

<div class="mt-4">
    <%= render "shared/pagination", collection: @veterinarios %>
</div>
