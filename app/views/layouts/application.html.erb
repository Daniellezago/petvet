<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Petvet" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>

  <body class="bg-gray-50">
    <% if user_signed_in? %>
      <div class="flex h-screen overflow-hidden">

        <!-- SIDEBAR -->
        <aside class="w-64 bg-emerald-700 text-white flex flex-col">
          <div class="p-6 text-2xl font-bold border-b border-emerald-600">
            🐾 PetVet
          </div>

  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <%= link_to root_path, class: "flex items-center gap-3 px-3 py-2 rounded hover:bg-emerald-600 transition" do %>
      <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
    <% end %>

  <details open class="group">
    <summary class="list-none cursor-pointer flex items-center justify-between px-3 py-2 rounded hover:bg-emerald-600 transition text-emerald-200 text-xs font-semibold uppercase tracking-wide">
      Cadastros
      <i data-lucide="chevron-down" class="w-4 h-4 group-open:rotate-180 transition-transform"></i>
    </summary>
    <div class="pl-2 space-y-1 mt-1">
      <%= link_to tutores_path, class: "flex items-center gap-3 px-3 py-2 rounded hover:bg-emerald-600 transition" do %>
        <i data-lucide="users" class="w-5 h-5"></i> Tutores
      <% end %>
      <%= link_to pets_path, class: "flex items-center gap-3 px-3 py-2 rounded hover:bg-emerald-600 transition" do %>
        <i data-lucide="paw-print" class="w-5 h-5"></i> Pets
      <% end %>
    </div>
  </details>

  <details open class="group">
    <summary class="list-none cursor-pointer flex items-center justify-between px-3 py-2 rounded hover:bg-emerald-600 transition text-emerald-200 text-xs font-semibold uppercase tracking-wide">
      Veterinário
      <i data-lucide="chevron-down" class="w-4 h-4 group-open:rotate-180 transition-transform"></i>
    </summary>
    <div class="pl-2 space-y-1 mt-1">
      <%= link_to consultas_path, class: "flex items-center gap-3 px-3 py-2 rounded hover:bg-emerald-600 transition" do %>
        <i data-lucide="stethoscope" class="w-5 h-5"></i> Consultas
      <% end %>
      <%= link_to vacinas_path, class: "flex items-center gap-3 px-3 py-2 rounded hover:bg-emerald-600 transition" do %>
        <i data-lucide="syringe" class="w-5 h-5"></i> Vacinas
      <% end %>
      <%= link_to exames_path, class: "flex items-center gap-3 px-3 py-2 rounded hover:bg-emerald-600 transition" do %>
        <i data-lucide="file-text" class="w-5 h-5"></i> Exames
      <% end %>
      <%= link_to pesos_path, class: "flex items-center gap-3 px-3 py-2 rounded hover:bg-emerald-600 transition" do %>
        <i data-lucide="scale" class="w-5 h-5"></i> Pesos
      <% end %>
      <%= link_to agendamentos_path, class: "flex items-center gap-3 px-3 py-2 rounded hover:bg-emerald-600 transition" do %>
        <i data-lucide="calendar" class="w-5 h-5"></i> Agendamentos
      <% end %>
    </div>
  </details>

  <details class="group">
    <summary class="list-none cursor-pointer flex items-center justify-between px-3 py-2 rounded hover:bg-emerald-600 transition text-emerald-200 text-xs font-semibold uppercase tracking-wide">
      Financeiro
      <i data-lucide="chevron-down" class="w-4 h-4 group-open:rotate-180 transition-transform"></i>
    </summary>
    <div class="pl-2 mt-1">
      <p class="px-3 py-2 text-sm text-emerald-300 italic">Em breve</p>
    </div>
  </details>

  <% if current_user.admin? %>
    <details class="group">
      <summary class="list-none cursor-pointer flex items-center justify-between px-3 py-2 rounded hover:bg-emerald-600 transition text-emerald-200 text-xs font-semibold uppercase tracking-wide">
        Sistema
        <i data-lucide="chevron-down" class="w-4 h-4 group-open:rotate-180 transition-transform"></i>
      </summary>
      <div class="pl-2 space-y-1 mt-1">
        <%= link_to usuarios_path, class: "flex items-center gap-3 px-3 py-2 rounded hover:bg-emerald-600 transition" do %>
          <i data-lucide="user-cog" class="w-5 h-5"></i> Usuários
        <% end %>
      </div>
    </details>
  <% end %>
</nav>
        </aside>

        <!-- ÁREA PRINCIPAL -->
        <div class="flex-1 flex flex-col overflow-hidden">

          <!-- TOPBAR -->
          <header class="bg-white border-b border-gray-200 px-6 py-4 flex justify-between items-center">
            <h1 class="text-lg font-semibold text-gray-800">
              <%= content_for(:title) || "Dashboard" %>
            </h1>

            <div class="flex items-center gap-4">
              <span class="text-sm text-gray-600"><%= current_user.email %></span>
              <%= button_to "Sair", destroy_user_session_path, method: :delete,
                  class: "text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded transition" %>
            </div>
          </header>

          <!-- CONTEÚDO DA PÁGINA -->
          <main class="flex-1 overflow-y-auto p-6">
            <%= yield %>
          </main>

        </div>
      </div>

    <% else %>
      <!-- SEM LOGIN: página centralizada, sem sidebar -->
      <main class="min-h-screen flex flex-col items-center justify-center gap-4">
        <% if notice %>
          <div class="bg-emerald-50 text-emerald-700 text-sm rounded p-3 max-w-sm w-full text-center">
            <%= notice %>
          </div>
        <% end %>
        <% if alert %>
          <div class="bg-red-50 text-red-700 text-sm rounded p-3 max-w-sm w-full text-center">
            <%= alert %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    <% end %>
    <script>
      document.addEventListener("turbo:load", () => lucide.createIcons());
    </script>
  </body>
</html>
