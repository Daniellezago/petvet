<% content_for :title, @pet.nome %>
<div class="bg-white rounded-xl shadow p-6 max-w-lg space-y-3">
  <h2 class="text-xl font-semibold text-gray-800"><%= @pet.nome %></h2>
  <p class="text-gray-600"><span class="font-medium">Espécie:</span> <%= @pet.especie %></p>
  <p class="text-gray-600"><span class="font-medium">Raça:</span> <%= @pet.raca %></p>
  <p class="text-gray-600"><span class="font-medium">Sexo:</span> <%= @pet.sexo %></p>
  <p class="text-gray-600"><span class="font-medium">Tutor:</span> <%= link_to @pet.tutor.nome, tutor_path(@pet.tutor), class: "text-emerald-700 hover:underline" %></p>
  <div class="flex gap-3 pt-4">
    <%= link_to "Editar", edit_pet_path(@pet), class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition" %>
    <%= link_to "Voltar", pets_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
  </div>
</div>
