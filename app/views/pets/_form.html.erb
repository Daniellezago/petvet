<%= form_with model: pet, local: true, multipart: true, class: "bg-white rounded-xl shadow max-w-2xl" do |f| %>
  <div class="px-6 py-5 border-b border-gray-100 flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
      <i data-lucide="paw-print" class="w-5 h-5 text-emerald-600"></i>
    </div>
    <div>
      <h3 class="text-base font-semibold text-gray-800">
        <%= pet.persisted? ? "Dados do Pet" : "Cadastrar Novo Pet" %>
      </h3>
      <p class="text-xs text-gray-400">
        <%= pet.persisted? ? "Atualize as informações abaixo" : "Preencha as informações para o cadastro" %>
      </p>
    </div>
  </div>

  <div class="px-6 py-6 space-y-5">
    <% if pet.errors.any? %>
      <div class="bg-red-50 border border-red-100 text-red-700 text-sm rounded-lg p-4 flex gap-3">
        <i data-lucide="alert-circle" class="w-4 h-4 shrink-0 mt-0.5"></i>
        <div>
          <p class="font-semibold mb-1">
            <%= pluralize(pet.errors.count, "erro encontrado", "erros encontrados") %>
          </p>
          <ul class="list-disc list-inside space-y-0.5">
            <% pet.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="flex items-center gap-4">
      <% if pet.foto.attached? %>
        <%= image_tag pet.foto, class: "w-16 h-16 rounded-full object-cover border border-gray-200" %>
      <% else %>
        <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
          <i data-lucide="paw-print" class="w-6 h-6"></i>
        </div>
      <% end %>
      <div class="flex-1">
        <%= f.label :foto, "Foto do pet", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.file_field :foto, accept: "image/png,image/jpeg,image/webp",
            class: "w-full text-sm text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-emerald-50 file:text-emerald-700 file:text-sm file:font-medium hover:file:bg-emerald-100" %>
        <p class="text-xs text-gray-400 mt-1">JPEG, PNG ou WEBP, até 5MB.</p>
      </div>
    </div>

    <div>
      <%= f.label :tutor_id, "Tutor", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :tutor_id, Tutor.ativos, :id, :nome, {},
          class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :nome, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :nome, placeholder: "Nome do pet",
            class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :especie, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :especie, placeholder: "Ex: Canina, Felina",
            class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :raca, "Raça", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :raca,
            class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :sexo, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :sexo, [ [ "Macho", "macho" ], [ "Fêmea", "femea" ] ], {},
            class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :porte, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :porte, [ [ "Pequeno", "pequeno" ], [ "Médio", "medio" ], [ "Grande", "grande" ] ], {},
            class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :cor, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :cor,
            class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :data_nascimento, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :data_nascimento,
            class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :peso_atual, "Peso (kg)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :peso_atual, step: "0.1",
            class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" %>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :castrado, class: "rounded border-gray-300 text-emerald-600 focus:ring-emerald-500" %>
      <%= f.label :castrado, "Castrado(a)", class: "text-sm text-gray-600" %>
    </div>
  </div>

  <div class="px-6 py-4 border-t border-gray-100 flex items-center gap-3">
    <%= f.submit (pet.persisted? ? "Salvar alterações" : "Cadastrar pet"),
        class: "bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition cursor-pointer" %>
    <%= link_to "Cancelar", pets_path,
        class: "px-5 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition" %>
  </div>
<% end %>

