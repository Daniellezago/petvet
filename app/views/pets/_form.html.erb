<%= form_with model: pet, local: true, class: "space-y-4 bg-white rounded-xl shadow p-6 max-w-lg" do |f| %>
  <% if pet.errors.any? %>
    <div class="bg-red-50 text-red-700 text-sm rounded p-3">
      <ul class="list-disc list-inside"><% pet.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>
  <div>
    <%= f.label :tutor_id, "Tutor", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :tutor_id, Tutor.ativos, :id, :nome, {}, class: "w-full rounded border border-gray-300 p-2" %>
  </div>
  <div>
    <%= f.label :nome, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :nome, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
  </div>
  <div>
    <%= f.label :especie, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :especie, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
  </div>
  <div>
    <%= f.label :raca, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :raca, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
  </div>
  <div>
    <%= f.label :sexo, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :sexo, [ [ "Macho", "macho" ], [ "Fêmea", "femea" ] ], {}, class: "w-full rounded border border-gray-300 p-2" %>
  </div>
  <p class="text-gray-600"><span class="font-medium">Idade:</span> <%= @pet.idade || "Não informada" %></p>
  <p class="text-gray-600"><span class="font-medium">Porte:</span> <%= @pet.porte.capitalize %></p>
  <p class="text-gray-600"><span class="font-medium">Cor:</span> <%= @pet.cor %></p>
  <p class="text-gray-600"><span class="font-medium">Castrado:</span> <%= @pet.castrado? ? "Sim" : "Não" %></p>
  <div>
  <%= f.label :porte, class: "block text-sm font-medium text-gray-700 mb-1" %>
  <%= f.select :porte, [ [ "Pequeno", "pequeno" ], [ "Médio", "medio" ], [ "Grande", "grande" ] ], {}, class: "w-full rounded border border-gray-300 p-2" %>
  </div>
  <div>
  <%= f.label :cor, class: "block text-sm font-medium text-gray-700 mb-1" %>
  <%= f.text_field :cor, class: "w-full rounded border border-gray-300 p-2" %>
  </div>
  <div class="flex items-center gap-2">
  <%= f.check_box :castrado, class: "rounded border-gray-300 text-emerald-600" %>
  <%= f.label :castrado, "Castrado(a)", class: "text-sm text-gray-600" %>
  </div>
  <div>
    <%= f.label :data_nascimento, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :data_nascimento, class: "w-full rounded border border-gray-300 p-2" %>
  </div>
  <div>
    <%= f.label :peso_atual, "Peso (kg)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :peso_atual, step: "0.1", class: "w-full rounded border border-gray-300 p-2" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold transition cursor-pointer" %>
    <%= link_to "Cancelar", pets_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
