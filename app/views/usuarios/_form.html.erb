<%= form_with model: usuario, url: usuario.persisted? ? usuario_path(usuario) : usuarios_path, local: true, class: "space-y-4 bg-white rounded-xl shadow p-6 max-w-lg" do |f| %>
    <% if usuario.errors.any? %>
        <div class="bg-red-50 text-red-700 text-sm rounded p-3">
            <ul class="list-disc list-inside"><% usuario.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
        </div>
    <% end %>
        <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.email_field :email, class: "w-full rounded border border-gray-300 p-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
        </div>
        <div>
            <%= f.label :role, "Papel", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :role, [ [ "Admin", "admin" ], [ "Veterinário", "veterinario" ], [ "Atendente", "atendente" ] ], {}, class: "w-full rounded border border-gray-300 p-2" %>
        </div>
        <div>
            <%= f.label :crmv, "CRMV (apenas para veterinários)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :crmv, class: "w-full rounded border border-gray-300 p-2" %>
        </div>
        <div>
            <%= f.label :password, usuario.persisted? ? "Nova senha (deixe em branco para manter)" : "Senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password, class: "w-full rounded border border-gray-300 p-2" %>
        </div>
        <div>
            <%= f.label :password_confirmation, "Confirmar senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password_confirmation, class: "w-full rounded border border-gray-300 p-2" %>
        </div>
            <% if usuario.persisted? %>
        <div class="flex items-center gap-2">
            <%= f.check_box :ativo, class: "rounded border-gray-300 text-emerald-600" %>
            <%= f.label :ativo, "Usuário ativo", class: "text-sm text-gray-600" %>
        </div>
        <% end %>
        <div class="flex gap-3">
            <%= f.submit class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded font-semibold transition cursor-pointer" %>
            <%= link_to "Cancelar", usuarios_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
        </div>
<% end %>
