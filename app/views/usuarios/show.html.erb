<% content_for :title, @usuario.email %>
<div class="bg-white rounded-xl shadow p-6 max-w-lg space-y-3">
    <h2 class="text-xl font-semibold text-gray-800"><%= @usuario.email %></h2>
    <p class="text-gray-600"><span class="font-medium">Papel:</span> <%= @usuario.role.capitalize %></p>
    <p class="text-gray-600"><span class="font-medium">CRMV:</span> <%= @usuario.crmv.presence || "-" %></p>
    <p class="text-gray-600"><span class="font-medium">Status:</span> <%= @usuario.ativo? ? "Ativo" : "Inativo" %></p>
<div class="flex gap-3 pt-4">
    <%= link_to "Editar", edit_usuario_path(@usuario), class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition" %>
    <%= link_to "Voltar", usuarios_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
</div>
</div>
