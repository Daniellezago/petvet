<% content_for :title,"Ativar autenticação de dois fatores" %>

<div class="mb-6">
    <%= link_to perfil_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do  %>
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Voltar para o perfil
    <% end %>
</div>

<div class="bg-white rounded-xl shadow max-w-lg" >
    <div class="px-6 py-5 border-b border-gray-100" >
        <h2 class="text-lg font-semibold text-gray-800">Ativar autenticação de dois fatores</h2>
        <p class="text-sm text-gray-500 mt-1"> Escaneie o QR code com o Google Authenticator, Microsoft Authenticator ou app similar.</p>
    </div>

    <div class="px-6 py-6 space-y-5" >
        <% if flash[:alert] %>
            <div class="bg-red-50 borde-red-100 text-red-700 text-sm rounded-lg p-3" >
                <%= flash[:alert] %>
            </div>
        <% end %>

    <div class="flex justify-center bg-gray-50 rounded-lg p-4">
        <div class="w-40 h-40">
            <%= raw RQRCode::QRCode.new(current_user.otp_provisioning_uri).as_svg(module_size: 3, use_path: true, viewbox: true) %>
        </div>
    </div>

        <div>
            <p class="text-xs text-gray-400 mb-1">
                Não consegue escanear o QR code? Cole esta chave <strong>dentro do app autenticador</strong> (opção "inserir chave manualmente"), não no campo abaixo:
            </p>
            <div class="flex items-center gap-2 bg-gray-50 rounded px-3 py-2">
                <p class="text-sm font-mono text-gray-700 break-all flex-1"><%= current_user.otp_secret %></p>
                <button type="button"
                    data-controller="clipboard"
                    data-clipboard-text-value="<%= current_user.otp_secret %>"
                    data-action="click->clipboard#copy"
                    class="shrink-0 text-xs font-semibold text-emerald-700 hover:text-emerald-800 px-2 py-1 rounded border border-emerald-200 hover:bg-emerald-50 transition">
        Copiar
    </button>
    </div>
</div>

        <%= form_with url: dois_fatores_path, method: :post, local: true, class: "space-y-3" do |f|  %>
            <div>
                <%= f.label :codigo, "Digite o código de 6 digitos gerado pelo app", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_field :codigo, inputmode: "numeric", maxlength: 6, autocomplete: "one-time-code", autofocus: true,
                    class: "w-full rounded-lg border border-gray-300 p-2.5 text-sm tracking-widest text-center focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
            </div>
            <%= f.submit "Confirmar e ativar",
                class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition cursor-pointer" %>
        <% end %>
    </div>
</div>




