<% content_for :title, "Consulta" %>
<div class="bg-white rounded-xl shadow p-6 max-w-lg space-y-3">
  <h2 class="text-xl font-semibold text-gray-800">Consulta de <%= @consulta.pet.nome %></h2>
  <p class="text-gray-600"><span class="font-medium">Data:</span> <%= @consulta.data.strftime("%d/%m/%Y %H:%M") %></p>
  <p class="text-gray-600"><span class="font-medium">Descrição:</span> <%= @consulta.descricao %></p>
  <p class="text-gray-600"><span class="font-medium">Diagnóstico:</span> <%= @consulta.diagnostico %></p>
  <p class="text-gray-600"><span class="font-medium">Tratamento:</span> <%= @consulta.tratamento %></p>
  <div class="flex gap-3 pt-4">
    <%= link_to "Editar", edit_consulta_path(@consulta), class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition" %>
    <%= link_to "Voltar", consultas_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
  </div>
</div>
