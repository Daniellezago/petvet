<% content_for :title, "Dashboard" %>

<div class="flex justify-between items-start mb-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-800">Visão Geral</h2>
    <p class="text-sm text-gray-500">Acompanhe as métricas essenciais da clínica</p>
  </div>

  <details class="relative">
    <summary class="list-none cursor-pointer flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition">
      <i data-lucide="calendar-days" class="w-4 h-4"></i>
      <%= DashboardController::PERIODOS[@periodo][:label] %>
      <i data-lucide="chevron-down" class="w-4 h-4"></i>
    </summary>

    <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-100 py-1 z-10">
      <% DashboardController::PERIODOS.each do |chave, info| %>
        <%= link_to info[:label], dashboard_index_path(periodo: chave),
            class: "block px-4 py-2 text-sm hover:bg-gray-50 #{"text-emerald-700 font-semibold" if chave == @periodo} #{"text-gray-600" if chave != @periodo}" %>
      <% end %>
    </div>
  </details>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow p-6 flex items-center gap-4">
    <div class="bg-emerald-100 text-emerald-700 rounded-full p-3">
      <i data-lucide="users" class="w-6 h-6"></i>
    </div>
    <div>
      <p class="text-sm text-gray-500">Tutores ativos</p>
      <p class="text-2xl font-bold text-gray-800"><%= Tutor.ativos.count %></p>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow p-6 flex items-center gap-4">
    <div class="bg-blue-100 text-blue-700 rounded-full p-3">
      <i data-lucide="paw-print" class="w-6 h-6"></i>
    </div>
    <div>
      <p class="text-sm text-gray-500">Pets cadastrados</p>
      <p class="text-2xl font-bold text-gray-800"><%= Pet.count %></p>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow p-6 flex items-center gap-4">
    <div class="bg-purple-100 text-purple-700 rounded-full p-3">
      <i data-lucide="dna" class="w-6 h-6"></i>
    </div>
    <div>
      <p class="text-sm text-gray-500">Raças cadastradas</p>
      <p class="text-2xl font-bold text-gray-800"><%= @total_racas %></p>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow p-6 flex items-center gap-4">
    <div class="bg-amber-100 text-amber-700 rounded-full p-3">
      <i data-lucide="calendar" class="w-6 h-6"></i>
    </div>
    <div>
      <p class="text-sm text-gray-500">Agendamentos</p>
      <p class="text-2xl font-bold text-gray-800"><%= Agendamento.count %></p>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  <div class="bg-white rounded-xl shadow p-6 lg:col-span-2">
    <h3 class="text-sm font-semibold text-gray-700 mb-1">Crescimento no período</h3>
    <p class="text-xs text-gray-400 mb-4">Novos tutores e pets cadastrados</p>

    <%= area_chart [
          { name: "Pets", data: @pets_por_mes, color: "#0ea5e9" },
          { name: "Tutores", data: @tutores_por_mes, color: "#059669" }
        ],
        curve: true,
        library: {
          elements: { line: { tension: 0.4 } },
          plugins: { legend: { display: true, position: "bottom" } },
          scales: { y: { stacked: false } }
        } %>
  </div>

  <div class="bg-white rounded-xl shadow p-6">
    <h3 class="text-sm font-semibold text-gray-700 mb-1">Pets por raça</h3>
    <p class="text-xs text-gray-400 mb-4">Distribuição das raças mais cadastradas</p>

    <%= pie_chart @pets_por_raca.map { |(especie, raca), count| ["#{raca.presence || "Não informada"} (#{especie})", count] },
        colors: ["#059669", "#0ea5e9", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899", "#14b8a6"],
        donut: true,
        legend: false,
        height: "180px" %>

    <div class="mt-4 space-y-2">
      <% total = @pets_por_raca.values.sum.to_f %>
      <% cores = ["bg-emerald-600", "bg-sky-500", "bg-amber-500", "bg-red-500", "bg-violet-500", "bg-pink-500", "bg-teal-500"] %>
      <% @pets_por_raca.sort_by { |_, count| -count }.each_with_index do |((especie, raca), count), i| %>
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full <%= cores[i % cores.length] %>"></span>
            <div>
              <p class="text-gray-700 font-medium"><%= raca.presence || "Não informada" %></p>
              <p class="text-xs text-gray-400"><%= especie %></p>
            </div>
          </div>
          <span class="text-gray-500"><%= count %> (<%= (count / total * 100).round(1) %>%)</span>
        </div>
      <% end %>
    </div>
  </div>
</div>



